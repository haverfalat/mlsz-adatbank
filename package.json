{
  "name": "mlsz-adatbank",
  "version": "0.2.0",
  "description": "Unofficial TypeScript client for the MLSZ Adatbank public stats site.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mlsz",
    "adatbank",
    "soccer",
    "hungary",
    "scraper"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}